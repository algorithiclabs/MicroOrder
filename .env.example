# Supabase: use the server-side Postgres connection string.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Resend: create an API key and verify the sender domain first.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=MicroOrder <updates@example.com>

# Optional local settings
MICROORDER_HOST=127.0.0.1
MICROORDER_PORT=8000
